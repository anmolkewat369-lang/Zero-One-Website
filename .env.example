# Server-only Resend configuration. Never expose RESEND_API_KEY as a NEXT_PUBLIC variable.
RESEND_API_KEY=
# Inbox that should receive project enquiries.
CONTACT_EMAIL=
# Must be a sender identity verified in your Resend account.
RESEND_FROM_EMAIL=

# Public contact links, digits with country code for WhatsApp; phone may include a leading +.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=

# The deployed origin only; use the actual temporary hosting URL until a domain is chosen.
# Example: https://zero-one-preview.vercel.app
NEXT_PUBLIC_SITE_URL=
# Keep previews out of search results; set true only for the public production site.
NEXT_PUBLIC_ALLOW_INDEXING=
